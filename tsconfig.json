{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "shared/types": ["./shared/types/index.ts"]
    }
  },
  "include": ["api/**/*", "lib/**/*", "shared/types/**/*"],
  "exclude": ["node_modules", "PigHouseFE", "server"]
}
